            >
              <LogOut className="h-3.5 w-3.5" />
              <span>{t.logout}</span>
            </button>
          </div>
        </aside>

        {/* Dynamic Display Screen */}
        <main className="flex-1 bg-slate-900 border border-slate-800 rounded-2xl p-4 sm:p-6 shadow-xl flex flex-col gap-6 overflow-hidden">
          
          {/* Sharia & Risk Transparency Banner */}
          <div className="bg-amber-500/10 border border-amber-500/30 rounded-xl p-3 flex items-start space-x-3 text-amber-300 text-xs sm:text-sm">
            <AlertCircle className="h-5 w-5 text-amber-400 shrink-0 mt-0.5" />
            <div>
              <p className="font-medium">{t.legalNotice}</p>
            </div>
          </div>

          {/* SCREEN 1: HOMEPAGE */}
          {activeTab === 'home' && (
            <div className="space-y-8 py-2">
              <div className="text-center space-y-4 max-w-2xl mx-auto py-6">
                <span className="bg-emerald-500/10 text-emerald-400 text-xs font-bold px-3 py-1 rounded-full border border-emerald-500/20">
                  বাংলাদেশী ব্যবসা ও বিনিয়োগ পোর্টাল
                </span>
                <h2 className="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-100">
                  স্মার্ট উপায়ে লাভজনক ব্যবসায় অংশগ্রহণ করুন
                </h2>
                <p className="text-slate-400 text-sm sm:text-base leading-relaxed">
                  Smart Business BD প্ল্যাটফর্মে ই-কমার্স, হালাল ট্রেডিং, পাইকারি ব্যবসা এবং বিশেষ প্রোজেক্টে সহজেই বিনিয়োগ করুন।
                </p>
                
                <div className="flex flex-wrap justify-center gap-3 pt-2">
                  <button
                    onClick={() => setActiveTab('packages')}
                    className="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-6 py-3 rounded-xl transition shadow-lg flex items-center space-x-2 text-sm"
                  >
                    <span>প্যাকেজসমূহ দেখুন</span>
                    <ArrowRight className="h-4 w-4" />
                  </button>
                  <button
                    onClick={() => setActiveTab('login')}
                    className="bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold px-6 py-3 rounded-xl border border-slate-700 transition text-sm"
                  >
                    একাউন্ট খুলুন
                  </button>
                </div>
              </div>

              {/* Business Sectors Highlight */}
              <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div className="bg-slate-800/50 border border-slate-800 p-5 rounded-2xl space-y-2">
                  <div className="bg-emerald-500/20 p-2.5 w-fit rounded-xl text-emerald-400">
                    <Building2 className="h-6 w-6" />
                  </div>
                  <h3 className="font-bold text-lg text-slate-100">ই-কমার্স বিজনেস্</h3>
                  <p className="text-xs text-slate-400">১,০০০ টাকা থেকে ১০,০০০ টাকা পর্যন্ত বিভিন্ন মেয়াদী প্রজেক্ট।</p>
                </div>

                <div className="bg-slate-800/50 border border-slate-800 p-5 rounded-2xl space-y-2">
                  <div className="bg-teal-500/20 p-2.5 w-fit rounded-xl text-teal-400">
                    <ShieldCheck className="h-6 w-6" />
                  </div>
                  <h3 className="font-bold text-lg text-slate-100">হালাল ট্রেডিং</h3>
                  <p className="text-xs text-slate-400">৫,০০০ টাকার নীতিসম্মত ও শরীয়াহ সম্মত খাদ্য পণ্য ট্রেডিং।</p>
                </div>

                <div className="bg-slate-800/50 border border-slate-800 p-5 rounded-2xl space-y-2">
                  <div className="bg-amber-500/20 p-2.5 w-fit rounded-xl text-amber-400">
                    <Package className="h-6 w-6" />
                  </div>
                  <h3 className="font-bold text-lg text-slate-100">পাইকারি ব্যবসা</h3>
                  <p className="text-xs text-slate-400">১০,০০০ টাকা থেকে ২৫,০০০ টাকার বাল্ক সাপ্লাই বিজনেস্।</p>
                </div>

                <div className="bg-slate-800/50 border border-slate-800 p-5 rounded-2xl space-y-2">
                  <div className="bg-indigo-500/20 p-2.5 w-fit rounded-xl text-indigo-400">
                    <TrendingUp className="h-6 w-6" />
                  </div>
                  <h3 className="font-bold text-lg text-slate-100">স্পেশাল প্রজেক্ট</h3>
                  <p className="text-xs text-slate-400">২০,০০০ টাকা থেকে ৫০,০০০ টাকার মেগা এগ্রো ও টেক প্রজেক্ট।</p>
                </div>
              </div>
            </div>
          )}

          {/* SCREEN 2: AUTHENTICATION */}
          {activeTab === 'login' && (
            <div className="max-w-md w-full mx-auto py-6 space-y-6">
              <div className="text-center space-y-1">
                <h2 className="text-2xl font-bold tracking-tight">
                  {authMode === 'login' ? 'স্মার্ট বিজনেস বিডি লগইন' : 'নতুন একাউন্ট রেজিস্টার করুন'}
                </h2>
                <p className="text-slate-400 text-xs">Supabase ভেরিফাইড সিকিউর অথেন্টিকেশন</p>
              </div>

              {authError && (
                <div className="bg-rose-500/20 border border-rose-500/30 text-rose-300 p-3 rounded-xl text-xs">
                  {authError}
                </div>
              )}

              <form onSubmit={handleAuthSubmit} className="bg-slate-800/60 border border-slate-800 p-5 rounded-2xl space-y-4">
                {authMode === 'register' && (
                  <>
                    <div>
                      <label className="block text-xs font-medium text-slate-300 mb-1">পূর্ণ নাম</label>
                      <input
                        type="text"
                        placeholder="আপনার নাম লিখুন"
                        value={authName}
                        onChange={(e) => setAuthName(e.target.value)}
                        className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                        required
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-medium text-slate-300 mb-1">মোবাইল নম্বর</label>
                      <input
                        type="text"
                        placeholder="017XXXXXXXX"
                        value={authPhone}
                        onChange={(e) => setAuthPhone(e.target.value)}
                        className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                        required
                      />
                    </div>
                  </>
                )}

                <div>
                  <label className="block text-xs font-medium text-slate-300 mb-1">ইমেইল ঠিকানা</label>
                  <input
                    type="email"
                    placeholder="email@example.com"
                    value={authEmail}
                    onChange={(e) => setAuthEmail(e.target.value)}
                    className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                    required
                  />
                </div>

                <div>
                  <label className="block text-xs font-medium text-slate-300 mb-1">পাসওয়ার্ড</label>
                  <input
                    type="password"
                    placeholder="••••••••"
                    value={authPassword}
                    onChange={(e) => setAuthPassword(e.target.value)}
                    className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                    required
                  />
                </div>

                <button
                  type="submit"
                  disabled={authLoading}
                  className="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2.5 rounded-xl transition shadow-lg text-sm flex items-center justify-center space-x-2"
                >
                  {authLoading ? (
                    <RefreshCw className="h-4 w-4 animate-spin" />
                  ) : (
                    <>
                      {authMode === 'login' ? <LogIn className="h-4 w-4" /> : <UserPlus className="h-4 w-4" />}
                      <span>{authMode === 'login' ? t.login : t.register}</span>
                    </>
                  )}
                </button>

                <div className="text-center pt-2">
                  <button
                    type="button"
                    onClick={() => setAuthMode(authMode === 'login' ? 'register' : 'login')}
                    className="text-xs text-emerald-400 hover:underline"
                  >
                    {authMode === 'login' ? 'একাউন্ট নেই? রেজিস্ট্রেশন করুন' : 'আগে থেকেই একাউন্ট আছে? লগইন করুন'}
                  </button>
                </div>
              </form>
            </div>
          )}

          {/* SCREEN 3: MEMBER DASHBOARD */}
          {activeTab === 'dashboard' && (
            <div className="space-y-6">
              <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
                <div>
                  <h2 className="text-2xl font-bold tracking-tight">{t.dashboard}</h2>
                  <p className="text-slate-400 text-xs sm:text-sm">স্মার্ট বিজনেস বিডি মেম্বার প্যানেল</p>
                </div>
                
                <div className="flex gap-2 w-full sm:w-auto">
                  <button 
                    onClick={() => setActiveTab('deposits')} 
                    className="flex-1 sm:flex-none flex items-center justify-center space-x-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-semibold px-4 py-2 rounded-xl transition shadow-md"
                  >
                    <ArrowDownRight className="h-4 w-4" />
                    <span>{t.depositNow}</span>
                  </button>
                  <button 
                    onClick={() => setActiveTab('withdrawals')} 
                    className="flex-1 sm:flex-none flex items-center justify-center space-x-2 bg-slate-800 hover:bg-slate-700 text-white text-xs sm:text-sm font-semibold px-4 py-2 rounded-xl border border-slate-700 transition"
                  >
                    <ArrowUpRight className="h-4 w-4" />
                    <span>{t.withdrawNow}</span>
                  </button>
                </div>
              </div>

              {/* Financial Metrics Cards */}
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div className="bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-800 p-4 rounded-2xl shadow-lg relative overflow-hidden">
                  <div className="text-slate-400 text-xs font-medium uppercase tracking-wider mb-1">{t.balance}</div>
                  <div className="text-2xl sm:text-3xl font-extrabold text-emerald-400">৳ {currentUser.balance.toLocaleString()} BDT</div>
                  <Wallet className="absolute right-3 bottom-3 h-12 w-12 text-slate-800/80 pointer-events-none" />
                </div>

                <div className="bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-800 p-4 rounded-2xl shadow-lg relative overflow-hidden">
                  <div className="text-slate-400 text-xs font-medium uppercase tracking-wider mb-1">{t.totalInvested}</div>
                  <div className="text-2xl sm:text-3xl font-extrabold text-teal-300">৳ {currentUser.total_invested.toLocaleString()} BDT</div>
                  <Package className="absolute right-3 bottom-3 h-12 w-12 text-slate-800/80 pointer-events-none" />
                </div>

                <div className="bg-gradient-to-br from-slate-800 to-slate-900 border border-slate-800 p-4 rounded-2xl shadow-lg relative overflow-hidden">
                  <div className="text-slate-400 text-xs font-medium uppercase tracking-wider mb-1">সক্রিয় প্যাকেজ</div>
                  <div className="text-2xl sm:text-3xl font-extrabold text-amber-400">{participations.length} টি প্রজেক্ট</div>
                  <TrendingUp className="absolute right-3 bottom-3 h-12 w-12 text-slate-800/80 pointer-events-none" />
                </div>
              </div>

              {/* Participations List */}
              <div className="bg-slate-800/40 border border-slate-800 rounded-2xl p-4 sm:p-5">
                <h3 className="font-semibold text-lg mb-3 flex items-center space-x-2">
                  <Package className="h-5 w-5 text-emerald-400" />
                  <span>আমার চলমান বিজনেস ইনভেস্টমেন্ট</span>
                </h3>
                {participations.length === 0 ? (
                  <p className="text-slate-400 text-xs sm:text-sm py-4 text-center">কোনো সক্রিয় প্যাকেজ নেই। প্যাকেজ থেকে নতুন প্রজেক্টে যুক্ত হন।</p>
                ) : (
                  <div className="space-y-3">
                    {participations.map((p) => (
                      <div key={p.id} className="bg-slate-900 border border-slate-800 p-4 rounded-xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2">
                        <div>
                          <div className="font-semibold text-emerald-300 text-base">{p.package_name}</div>
                          <div className="text-xs text-slate-400">{p.sector} • সময়কাল শুরু: {p.joined_at}</div>
                        </div>
                        <div className="text-right">
                          <span className="text-sm font-bold text-white">৳ {p.amount.toLocaleString()} BDT</span>
                          <span className="block text-xs text-emerald-400 font-medium">{p.status}</span>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          )}

          {/* SCREEN 4: BUSINESS PACKAGES */}
          {activeTab === 'packages' && (
            <div className="space-y-6">
              <div>
                <h2 className="text-2xl font-bold tracking-tight">{t.packages}</h2>
                <p className="text-slate-400 text-xs sm:text-sm">ই-কমার্স, হালাল ট্রেডিং ও হোলসেল ব্যবসার কনফিগার করা প্যাকেজসমূহ</p>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
                {packages.map((pkg) => (
                  <div key={pkg.id} className="bg-gradient-to-br from-slate-900 to-slate-800 border border-slate-700/80 rounded-2xl p-5 flex flex-col justify-between hover:border-emerald-500/50 transition shadow-lg">
                    <div>
                      <div className="flex justify-between items-start mb-2">
                        <span className="bg-emerald-500/10 text-emerald-400 text-xs font-semibold px-2.5 py-1 rounded-full border border-emerald-500/20">
                          {pkg.sector}
                        </span>
                        <span className="text-xs text-slate-400 flex items-center space-x-1">
                          <Clock className="h-3.5 w-3.5" />
                          <span>{pkg.duration_days} দিন</span>
                        </span>
                      </div>
                      <h3 className="text-xl font-bold text-slate-100 mb-1">{pkg.name}</h3>
                      <p className="text-xs text-slate-400 mb-3">{pkg.description}</p>
                      
                      <div className="text-2xl font-extrabold text-emerald-400 mb-4">
                        ৳ {pkg.amount.toLocaleString()} <span className="text-xs font-normal text-slate-400">BDT</span>
                      </div>
                      
                      <div className="bg-slate-950/60 rounded-xl p-3 text-xs space-y-1.5 text-slate-300 mb-4 border border-slate-800">
                        <div className="flex justify-between">
                          <span className="text-slate-400">আনুমানিক মার্জিন:</span>
                          <span className="font-semibold text-emerald-300">{pkg.expected_profit_rate}</span>
                        </div>
                        <div className="flex justify-between">
                          <span className="text-slate-400">রিস্ক প্রোফাইল:</span>
                          <span className="font-semibold text-slate-300">প্রোজেক্টভিত্তিক লাভ/ক্ষতি</span>
                        </div>
                      </div>
                    </div>

                    <button
                      onClick={() => handlePackageInvest(pkg)}
                      className="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-2.5 rounded-xl transition shadow-md flex items-center justify-center space-x-2 text-sm"
                    >
                      <Plus className="h-4 w-4" />
                      <span>{t.participate}</span>
                    </button>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* SCREEN 5: DEPOSITS SYSTEM */}
          {activeTab === 'deposits' && (
            <div className="space-y-6">
              <div>
                <h2 className="text-2xl font-bold tracking-tight">{t.deposits}</h2>
                <p className="text-slate-400 text-xs sm:text-sm">বিকাশ, নগদ, রকেট বা ব্যাংকের মাধ্যমে ম্যানুয়াল ডিপোজিট প্রক্রিয়া</p>
              </div>

              <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <form onSubmit={handleDepositSubmit} className="bg-slate-800/60 border border-slate-800 rounded-2xl p-5 space-y-4 lg:col-span-1">
                  <h3 className="font-semibold text-lg border-b border-slate-700 pb-2">{t.depositNow}</h3>
                  
                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">{t.method}</label>
                    <select
                      value={depositForm.method}
                      onChange={(e) => setDepositForm({ ...depositForm, method: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                    >
                      {paymentMethods.map(pm => (
                        <option key={pm.id} value={pm.name}>{pm.name} ({pm.type})</option>
                      ))}
                    </select>
                  </div>

                  <div className="bg-slate-950 p-3 rounded-xl border border-slate-800 text-xs text-slate-300 space-y-1">
                    <div className="font-medium text-emerald-400">নির্দেশনাবলী:</div>
                    <p>{paymentMethods.find(p => p.name === depositForm.method)?.instructions}</p>
                    <div className="font-bold text-amber-300 pt-1">
                      নম্বর: {paymentMethods.find(p => p.name === depositForm.method)?.number}
                    </div>
                  </div>

                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">{t.amountBDT}</label>
                    <input
                      type="number"
                      placeholder="e.g. 5000"
                      value={depositForm.amount}
                      onChange={(e) => setDepositForm({ ...depositForm, amount: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                      required
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">{t.senderNum}</label>
                    <input
                      type="text"
                      placeholder="017XXXXXXXX"
                      value={depositForm.sender_number}
                      onChange={(e) => setDepositForm({ ...depositForm, sender_number: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                      required
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">{t.trxId}</label>
                    <input
                      type="text"
                      placeholder="e.g. TRX9823412"
                      value={depositForm.trx_id}
                      onChange={(e) => setDepositForm({ ...depositForm, trx_id: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                      required
                    />
                  </div>

                  <button
                    type="submit"
                    className="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-2.5 rounded-xl transition shadow-md text-sm"
                  >
                    ডিপোজিট আবেদন সাবমিট করুন
                  </button>
                </form>

                <div className="lg:col-span-2 bg-slate-800/40 border border-slate-800 rounded-2xl p-5 space-y-4">
                  <h3 className="font-semibold text-lg border-b border-slate-700 pb-2">ডিপোজিট ইতিহাস</h3>
                  <div className="overflow-x-auto">
                    <table className="w-full text-left text-xs sm:text-sm">
                      <thead className="text-slate-400 border-b border-slate-800 text-xs uppercase">
                        <tr>
                          <th className="py-2">Trx ID / তারিখ</th>
                          <th className="py-2">মেথড</th>
                          <th className="py-2">পরিমাণ</th>
                          <th className="py-2">স্ট্যাটাস</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-800">
                        {deposits.map((d) => (
                          <tr key={d.id} className="hover:bg-slate-800/30">
                            <td className="py-3">
                              <div className="font-medium text-slate-200">{d.trx_id}</div>
                              <div className="text-xs text-slate-500">{d.created_at}</div>
                            </td>
                            <td className="py-3 text-slate-300">{d.method}</td>
                            <td className="py-3 font-semibold text-emerald-400">৳ {d.amount.toLocaleString()}</td>
                            <td className="py-3">
                              <span className={`px-2 py-0.5 rounded-full text-xs font-semibold ${
                                d.status === 'Approved' ? 'bg-emerald-500/20 text-emerald-400' :
                                d.status === 'Pending' ? 'bg-amber-500/20 text-amber-400' : 'bg-rose-500/20 text-rose-400'
                              }`}>
                                {d.status}
                              </span>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* SCREEN 6: WITHDRAWALS SYSTEM */}
          {activeTab === 'withdrawals' && (
            <div className="space-y-6">
              <div>
                <h2 className="text-2xl font-bold tracking-tight">{t.withdrawals}</h2>
                <p className="text-slate-400 text-xs sm:text-sm">ব্যালেন্স থেকে সরাসরি পে-আউট রিকোয়েস্ট করুন</p>
              </div>

              <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <form onSubmit={handleWithdrawSubmit} className="bg-slate-800/60 border border-slate-800 rounded-2xl p-5 space-y-4 lg:col-span-1">
                  <h3 className="font-semibold text-lg border-b border-slate-700 pb-2">{t.withdrawNow}</h3>

                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">{t.method}</label>
                    <select
                      value={withdrawForm.method}
                      onChange={(e) => setWithdrawForm({ ...withdrawForm, method: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                    >
                      <option value="bKash">bKash Personal</option>
                      <option value="Nagad">Nagad Personal</option>
                      <option value="Rocket">Rocket Personal</option>
                      <option value="Bank Transfer">Bank Account</option>
                    </select>
                  </div>

                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">{t.amountBDT}</label>
                    <input
                      type="number"
                      placeholder="e.g. 2000"
                      value={withdrawForm.amount}
                      onChange={(e) => setWithdrawForm({ ...withdrawForm, amount: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                      required
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">একাউন্ট নম্বর / বিস্তারিত</label>
                    <input
                      type="text"
                      placeholder="017XXXXXXXX"
                      value={withdrawForm.account_number}
                      onChange={(e) => setWithdrawForm({ ...withdrawForm, account_number: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500"
                      required
                    />
                  </div>

                  <button
                    type="submit"
                    className="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-2.5 rounded-xl transition shadow-md text-sm"
                  >
                    উইথড্রয়াল আবেদন সাবমিট করুন
                  </button>
                </form>

                <div className="lg:col-span-2 bg-slate-800/40 border border-slate-800 rounded-2xl p-5 space-y-4">
                  <h3 className="font-semibold text-lg border-b border-slate-700 pb-2">উইথড্রয়াল ইতিহাস</h3>
                  <div className="overflow-x-auto">
                    <table className="w-full text-left text-xs sm:text-sm">
                      <thead className="text-slate-400 border-b border-slate-800 text-xs uppercase">
                        <tr>
                          <th className="py-2">তারিখ</th>
                          <th className="py-2">মেথড / টার্গেট</th>
                          <th className="py-2">পরিমাণ</th>
                          <th className="py-2">স্ট্যাটাস</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-slate-800">
                        {withdrawals.map((w) => (
                          <tr key={w.id} className="hover:bg-slate-800/30">
                            <td className="py-3 text-xs text-slate-400">{w.created_at}</td>
                            <td className="py-3">
                              <div className="font-medium text-slate-200">{w.method}</div>
                              <div className="text-xs text-slate-400">{w.account_number}</div>
                            </td>
                            <td className="py-3 font-semibold text-rose-400">৳ {w.amount.toLocaleString()}</td>
                            <td className="py-3">
                              <span className={`px-2 py-0.5 rounded-full text-xs font-semibold ${
                                w.status === 'Approved' ? 'bg-emerald-500/20 text-emerald-400' :
                                w.status === 'Pending' ? 'bg-amber-500/20 text-amber-400' : 'bg-rose-500/20 text-rose-400'
                              }`}>
                                {w.status}
                              </span>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* SCREEN 7: SUPPORT TICKETS */}
          {activeTab === 'support' && (
            <div className="space-y-6">
              <div>
                <h2 className="text-2xl font-bold tracking-tight">{t.support}</h2>
                <p className="text-slate-400 text-xs sm:text-sm">প্ল্যাটফর্ম সংক্রান্ত সমস্যা বা প্রশ্নের সমাধানের জন্য টিকিট খুলুন</p>
              </div>

              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                <form 
                  onSubmit={(e) => {
                    e.preventDefault();
                    if (!ticketForm.subject || !ticketForm.message) return;
                    setTickets([...tickets, {
                      id: `tkt-${Date.now()}`,
                      user_name: currentUser.name,
                      ...ticketForm,
                      status: 'Open',
                      created_at: new Date().toISOString().replace('T', ' ').substring(0, 16)
                    }]);
                    setTicketForm({ subject: '', category: 'General', message: '' });
                    alert('সাপোর্ট টিকিট সাবমিট করা হয়েছে।');
                  }}
                  className="bg-slate-800/60 border border-slate-800 rounded-2xl p-5 space-y-4"
                >
                  <h3 className="font-semibold text-lg border-b border-slate-700 pb-2">নতুন টিকিট সাবমিট</h3>
                  
                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">বিষয়</label>
                    <input
                      type="text"
                      placeholder="বিষয় লিখুন"
                      value={ticketForm.subject}
                      onChange={(e) => setTicketForm({ ...ticketForm, subject: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-100"
                      required
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-medium text-slate-300 mb-1">মেসেজ</label>
                    <textarea
                      rows={4}
                      placeholder="বিস্তারিত লিখুন..."
                      value={ticketForm.message}
                      onChange={(e) => setTicketForm({ ...ticketForm, message: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-slate-100"
                      required
                    />
                  </div>

                  <button type="submit" className="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-semibold py-2.5 rounded-xl transition text-sm">
                    টিকিট পাঠান
                  </button>
                </form>

                <div className="bg-slate-800/40 border border-slate-800 rounded-2xl p-5 space-y-3">
                  <h3 className="font-semibold text-lg border-b border-slate-700 pb-2">আমার সাপোর্ট থ্রেড</h3>
                  {tickets.map(t => (
                    <div key={t.id} className="bg-slate-900 border border-slate-800 p-3.5 rounded-xl space-y-1">
                      <div className="flex justify-between items-start">
                        <span className="font-semibold text-sm text-slate-200">{t.subject}</span>
                        <span className="bg-emerald-500/20 text-emerald-400 text-xs px-2 py-0.5 rounded-full">{t.status}</span>
                      </div>
                      <p className="text-xs text-slate-400">{t.message}</p>
                      <div className="text-[10px] text-slate-500 pt-1">{t.created_at}</div>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

          {/* SCREEN 8: FULL ADMIN DASHBOARD PANEL */}
          {activeTab === 'admin' && currentUser?.role === 'admin' && (
            <div className="space-y-6">
              <div className="flex justify-between items-center">
                <div>
                  <h2 className="text-2xl font-bold tracking-tight text-amber-400">{t.adminPanel}</h2>
                  <p className="text-slate-400 text-xs sm:text-sm">ডিপোজিট, উইথড্রয়াল, সদস্য অ্যাকাউন্ট এবং প্যাকেজ ম্যানেজমেন্ট</p>
                </div>
              </div>

              {/* High-level Platform Metrics */}
              <div className="grid grid-cols-2 lg:grid-cols-4 gap-4">
                <div className="bg-slate-800 border border-slate-700 p-4 rounded-xl">
                  <div className="text-xs text-slate-400">{t.allMembers}</div>
                  <div className="text-2xl font-bold text-white">{membersList.length} জন</div>
                </div>
                <div className="bg-slate-800 border border-slate-700 p-4 rounded-xl">
                  <div className="text-xs text-slate-400">{t.totalDeposits}</div>
                  <div className="text-2xl font-bold text-emerald-400">৳ {totalApprovedDeposits.toLocaleString()}</div>
                </div>
                <div className="bg-slate-800 border border-slate-700 p-4 rounded-xl">
                  <div className="text-xs text-slate-400">{t.pendingDeposit}</div>
                  <div className="text-2xl font-bold text-amber-400">{pendingDepositsCount} টি</div>
                </div>
                <div className="bg-slate-800 border border-slate-700 p-4 rounded-xl">
                  <div className="text-xs text-slate-400">{t.totalWithdrawals}</div>
                  <div className="text-2xl font-bold text-rose-400">৳ {totalApprovedWithdrawals.toLocaleString()}</div>
                </div>
              </div>

              {/* Pending Deposits Verification */}
              <div className="bg-slate-800/50 border border-slate-700 rounded-2xl p-5 space-y-4">
                <h3 className="font-semibold text-lg text-emerald-300">অপেক্ষমান ডিপোজিট ভেরিফিকেশন</h3>
                {deposits.filter(d => d.status === 'Pending').length === 0 ? (
                  <p className="text-xs text-slate-400">কোনো অপেক্ষমান ডিপোজিট রিকোয়েস্ট নেই।</p>
                ) : (
                  <div className="space-y-3">
                    {deposits.filter(d => d.status === 'Pending').map((d) => (
                      <div key={d.id} className="bg-slate-900 border border-slate-800 p-4 rounded-xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                        <div>
                          <div className="font-semibold text-sm text-slate-100">{d.user_name} ({d.sender_number})</div>
                          <div className="text-xs text-slate-400">{d.method} • TrxID: <span className="font-mono text-emerald-300">{d.trx_id}</span></div>
                          <div className="text-lg font-bold text-emerald-400 mt-1">৳ {d.amount.toLocaleString()} BDT</div>
                        </div>
                        <div className="flex space-x-2">
                          <button
                            onClick={() => handleApproveDeposit(d)}
                            className="bg-emerald-600 hover:bg-emerald-500 text-white text-xs px-3.5 py-2 rounded-xl font-semibold flex items-center space-x-1"
                          >
                            <CheckCircle2 className="h-4 w-4" />
                            <span>অনুমোদন করুন</span>
                          </button>
                          <button
                            onClick={() => handleRejectDeposit(d.id)}
                            className="bg-rose-600 hover:bg-rose-500 text-white text-xs px-3.5 py-2 rounded-xl font-semibold flex items-center space-x-1"
                          >
                            <XCircle className="h-4 w-4" />
                            <span>বাতিল</span>
                          </button>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>

              {/* Pending Withdrawals */}
              <div className="bg-slate-800/50 border border-slate-700 rounded-2xl p-5 space-y-4">
                <h3 className="font-semibold text-lg text-rose-300">অপেক্ষমান উইথড্রয়াল পেমেন্ট</h3>
                {withdrawals.filter(w => w.status === 'Pending').length === 0 ? (
                  <p className="text-xs text-slate-400">কোনো অপেক্ষমান উইথড্রয়াল রিকোয়েস্ট নেই।</p>
                ) : (
                  <div className="space-y-3">
                    {withdrawals.filter(w => w.status === 'Pending').map((w) => (
                      <div key={w.id} className="bg-slate-900 border border-slate-800 p-4 rounded-xl flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
                        <div>
                          <div className="font-semibold text-sm text-slate-100">{w.user_name}</div>
                          <div className="text-xs text-slate-400">{w.method} • একাউন্ট: <span className="font-mono text-amber-300">{w.account_number}</span></div>
                          <div className="text-lg font-bold text-rose-400 mt-1">৳ {w.amount.toLocaleString()} BDT</div>
                        </div>
                        <div className="flex space-x-2">
                          <button
                            onClick={() => handleApproveWithdrawal(w)}
                            className="bg-emerald-600 hover:bg-emerald-500 text-white text-xs px-3.5 py-2 rounded-xl font-semibold flex items-center space-x-1"
                          >
                            <CheckCircle2 className="h-4 w-4" />
                            <span>অনুমোদন</span>
                          </button>
                          <button
                            onClick={() => handleRejectWithdrawal(w)}
                            className="bg-rose-600 hover:bg-rose-500 text-white text-xs px-3.5 py-2 rounded-xl font-semibold flex items-center space-x-1"
                          >
                            <XCircle className="h-4 w-4" />
                            <span>বাতিল</span>
                          </button>
                        </div>
                      </div>
                    ))}
                  </div>
                )}
              </div>

              {/* Member Management List */}
              <div className="bg-slate-800/50 border border-slate-700 rounded-2xl p-5 space-y-4">
                <h3 className="font-semibold text-lg text-slate-200">সদস্য অ্যাকাউন্ট ম্যানেজমেন্ট</h3>
                <div className="overflow-x-auto">
                  <table className="w-full text-left text-xs sm:text-sm">
                    <thead className="text-slate-400 border-b border-slate-800 text-xs uppercase">
                      <tr>
                        <th className="py-2">নাম / ইমেইল</th>
                        <th className="py-2">ফোন</th>
                        <th className="py-2">ব্যালেন্স</th>
                        <th className="py-2">স্ট্যাটাস</th>
                        <th className="py-2">অ্যাকশন</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-slate-800">
                      {membersList.map((m) => (
                        <tr key={m.id} className="hover:bg-slate-800/30">
                          <td className="py-3">
                            <div className="font-semibold text-slate-200">{m.name}</div>
                            <div className="text-xs text-slate-500">{m.email}</div>
                          </td>
                          <td className="py-3 text-slate-300">{m.phone}</td>
                          <td className="py-3 font-semibold text-emerald-400">৳ {m.balance.toLocaleString()}</td>
                          <td className="py-3">
                            <span className={`px-2 py-0.5 rounded-full text-xs font-semibold ${
                              m.status === 'Active' ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400'
                            }`}>
                              {m.status}
                            </span>
                          </td>
                          <td className="py-3">
                            <button
                              onClick={() => handleToggleMemberStatus(m.id)}
                              className={`text-xs px-2.5 py-1 rounded-lg border font-medium ${
                                m.status === 'Active' ? 'border-rose-500/30 text-rose-400 hover:bg-rose-500/10' : 'border-emerald-500/30 text-emerald-400 hover:bg-emerald-500/10'
                              }`}
                            >
                              {m.status === 'Active' ? 'Suspend' : 'Activate'}
                            </button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>

              {/* Dynamic Package Creation Form */}
              <div className="bg-slate-800/50 border border-slate-700 rounded-2xl p-5 space-y-4">
                <h3 className="font-semibold text-lg text-slate-200">{t.createPackage}</h3>
                <form onSubmit={handleCreatePackage} className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                  <div>
                    <label className="block text-xs text-slate-300 mb-1">সেক্টর</label>
                    <select
                      value={newPkgForm.sector}
                      onChange={(e) => setNewPkgForm({ ...newPkgForm, sector: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white"
                    >
                      <option value="E-commerce">E-commerce</option>
                      <option value="Halal Trading">Halal Trading</option>
                      <option value="Wholesale Business">Wholesale Business</option>
                      <option value="Special Business Project">Special Business Project</option>
                    </select>
                  </div>

                  <div>
                    <label className="block text-xs text-slate-300 mb-1">প্যাকেজের নাম</label>
                    <input
                      type="text"
                      placeholder="e.g. Agro Venture"
                      value={newPkgForm.name}
                      onChange={(e) => setNewPkgForm({ ...newPkgForm, name: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white"
                      required
                    />
                  </div>

                  <div>
                    <label className="block text-xs text-slate-300 mb-1">পরিমাণ (BDT)</label>
                    <input
                      type="number"
                      placeholder="e.g. 15000"
                      value={newPkgForm.amount}
                      onChange={(e) => setNewPkgForm({ ...newPkgForm, amount: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white"
                      required
                    />
                  </div>

                  <div>
                    <label className="block text-xs text-slate-300 mb-1">প্রত্যাশিত মার্জিন</label>
                    <input
                      type="text"
                      placeholder="e.g. 5.0% - 8.0%"
                      value={newPkgForm.expected_profit_rate}
                      onChange={(e) => setNewPkgForm({ ...newPkgForm, expected_profit_rate: e.target.value })}
                      className="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-xs text-white"
                      required
                    />
                  </div>

                  <div className="sm:col-span-2 lg:col-span-4">
                    <button type="submit" className="bg-amber-600 hover:bg-amber-500 text-white font-semibold text-xs px-5 py-2.5 rounded-xl transition shadow-md">
                      প্যাকেজ যোগ করুন
                    </button>
                  </div>
                </form>
              </div>

              {/* Admin Audit Logs */}
              <div className="bg-slate-800/50 border border-slate-700 rounded-2xl p-5 space-y-3">
                <h3 className="font-semibold text-lg text-slate-200">এডমিন সিস্টেম লগসমূহ</h3>
                <div className="space-y-2">
                  {adminLogs.map(log => (
                    <div key={log.id} className="bg-slate-900 border border-slate-800 p-3 rounded-xl text-xs flex justify-between items-center">
                      <div>
                        <span className="font-bold text-emerald-400">{log.action}: </span>
                        <span className="text-slate-300">{log.details}</span>
                      </div>
                      <span className="text-slate-500 text-[10px]">{log.timestamp}</span>
                    </div>
                  ))}
                </div>
              </div>

            </div>
          )}

        </main>
      </div>

      {/* Footer */}
      <footer className="bg-slate-900 border-t border-slate-800 text-slate-400 py-4 px-6 text-center text-xs space-y-1">
        <p>© 2026 Smart Business BD. All rights reserved.</p>
        <p className="text-[11px] text-slate-500">Supabase Connected Database • Installable PWA Engine</p>
      </footer>
    </div>
  );
}
