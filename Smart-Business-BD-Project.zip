export default function App() {
  // Application State
  const [lang, setLang] = useState('bn');
  const [theme, setTheme] = useState('dark');
  const [activeTab, setActiveTab] = useState('home'); // home | dashboard | packages | deposits | withdrawals | transactions | support | admin
  const [isZipping, setIsZipping] = useState(false);
  const [zipProgress, setZipProgress] = useState(0);

  // Authentication State
  const [session, setSession] = useState(null);
  const [authMode, setAuthMode] = useState('login'); // login | register
  const [authEmail, setAuthEmail] = useState('');
  const [authPassword, setAuthPassword] = useState('');
  const [authName, setAuthName] = useState('');
  const [authPhone, setAuthPhone] = useState('');
  const [authLoading, setAuthLoading] = useState(false);
  const [authError, setAuthError] = useState('');

  // Current Active User Profile State
  const [currentUser, setCurrentUser] = useState({
    id: 'fd9122c4-20fe-4d28-af21-31f6564d51e0',
    name: 'Tanvir Hossain (Admin)',
    email: 'admin@smartbusinessbd.com',
    role: 'admin', // admin | member
    balance: 85000,
    total_invested: 45000,
    phone: '01700000000',
    status: 'Active'
  });

  // Business Platform Stores
  const [packages, setPackages] = useState(INITIAL_PACKAGES);
  const [paymentMethods, setPaymentMethods] = useState(INITIAL_PAYMENT_METHODS);

  const [deposits, setDeposits] = useState([
    { id: 'dep-101', user_id: 'fd9122c4-20fe-4d28-af21-31f6564d51e0', user_name: 'Tanvir Hossain', method: 'bKash', amount: 50000, sender_number: '01711223344', trx_id: 'TRX9823412', status: 'Approved', created_at: '2026-10-25 14:30' },
    { id: 'dep-102', user_id: 'usr-201', user_name: 'Abdur Rahim', method: 'Nagad', amount: 15000, sender_number: '01811998877', trx_id: 'NGD554411', status: 'Pending', created_at: '2026-11-01 10:15' },
    { id: 'dep-103', user_id: 'usr-202', user_name: 'Kamal Pasha', method: 'Rocket', amount: 20000, sender_number: '01922334455', trx_id: 'RCK887711', status: 'Approved', created_at: '2026-11-01 11:20' }
  ]);

  const [withdrawals, setWithdrawals] = useState([
    { id: 'wth-501', user_id: 'usr-202', user_name: 'Kamal Pasha', method: 'bKash', amount: 5000, account_number: '01922334455', status: 'Pending', created_at: '2026-11-01 12:00' }
  ]);

  const [participations, setParticipations] = useState([
    { id: 'prt-301', user_id: 'fd9122c4-20fe-4d28-af21-31f6564d51e0', package_name: 'Export Apparel Venture', sector: 'Special Business Project', amount: 25000, status: 'Active', joined_at: '2026-10-26' },
    { id: 'prt-302', user_id: 'fd9122c4-20fe-4d28-af21-31f6564d51e0', package_name: 'Agro Tech Project', sector: 'Special Business Project', amount: 20000, status: 'Active', joined_at: '2026-10-28' }
  ]);

  const [tickets, setTickets] = useState([
    { id: 'tkt-1', user_name: 'Abdur Rahim', subject: 'Deposit Verification Delay', category: 'Deposit', message: 'I submitted 15,000 BDT via Nagad. TrxID NGD554411. Please confirm.', status: 'Open', created_at: '2026-11-01 10:30' }
  ]);

  const [membersList, setMembersList] = useState([
    { id: 'fd9122c4-20fe-4d28-af21-31f6564d51e0', name: 'Tanvir Hossain', email: 'admin@smartbusinessbd.com', role: 'admin', balance: 85000, status: 'Active', phone: '01700000000' },
    { id: 'usr-201', name: 'Abdur Rahim', email: 'rahim@gmail.com', role: 'member', balance: 15000, status: 'Active', phone: '01811998877' },
    { id: 'usr-202', name: 'Kamal Pasha', email: 'kamal@gmail.com', role: 'member', balance: 15000, status: 'Active', phone: '01922334455' }
  ]);

  const [adminLogs, setAdminLogs] = useState([
    { id: 'log-1', admin_name: 'Tanvir Hossain', action: 'Approved Deposit', details: 'Approved 50,000 BDT deposit for Tanvir Hossain', timestamp: '2026-10-25 14:35' },
    { id: 'log-2', admin_name: 'Tanvir Hossain', action: 'System Init', details: 'Smart Business BD Backend and RLS initialized', timestamp: '2026-10-25 10:00' }
  ]);

  // Dynamic Forms State
  const [depositForm, setDepositForm] = useState({ method: 'bKash', amount: '', sender_number: '', trx_id: '' });
  const [withdrawForm, setWithdrawForm] = useState({ method: 'bKash', amount: '', account_number: '' });
  const [ticketForm, setTicketForm] = useState({ subject: '', category: 'General', message: '' });
  const [newPkgForm, setNewPkgForm] = useState({ sector: 'E-commerce', name: '', amount: 5000, duration_days: 60, expected_profit_rate: '4.0% - 6.0%', status: 'Active', description: '' });

  const t = i18n[lang];

  // Supabase Auth Integration Listener
  useEffect(() => {
    supabase.auth.getSession().then(({ data: { session } }) => {
      setSession(session);
      if (session?.user) {
        fetchUserProfile(session.user);
      }
    });

    const { data: { subscription } } = supabase.auth.onAuthStateChanged((_event, session) => {
      setSession(session);
      if (session?.user) {
        fetchUserProfile(session.user);
      }
    });

    return () => subscription.unsubscribe();
  }, []);

  const fetchUserProfile = async (authUser) => {
    try {
      const { data, error } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', authUser.id)
        .single();
      
      if (!error && data) {
        setCurrentUser(data);
      } else {
        // Fallback profile if user record is pending
        setCurrentUser({
          id: authUser.id,
          name: authUser.user_metadata?.full_name || authUser.email.split('@')[0],
          email: authUser.email,
          role: authUser.id === 'fd9122c4-20fe-4d28-af21-31f6564d51e0' ? 'admin' : 'member',
          balance: 0,
          total_invested: 0,
          phone: authUser.phone || '',
          status: 'Active'
        });
      }
    } catch (e) {
      console.log('Using local cached session profile', e);
    }
  };

  // Auth Operations
  const handleAuthSubmit = async (e) => {
    e.preventDefault();
    setAuthLoading(true);
    setAuthError('');

    try {
      if (authMode === 'login') {
        const { data, error } = await supabase.auth.signInWithPassword({
          email: authEmail,
          password: authPassword
        });

        if (error) throw error;
        alert(lang === 'bn' ? 'সফলভাবে লগইন হয়েছে!' : 'Login successful!');
        setActiveTab('dashboard');
      } else {
        const { data, error } = await supabase.auth.signUp({
          email: authEmail,
          password: authPassword,
          options: {
            data: {
              full_name: authName,
              phone: authPhone
            }
          }
        });

        if (error) throw error;
        
        // Local state sync for user simulation
        const newUser = {
          id: data.user?.id || `usr-${Date.now()}`,
          name: authName || authEmail.split('@')[0],
          email: authEmail,
          role: 'member',
          balance: 0,
          total_invested: 0,
          phone: authPhone,
          status: 'Active'
        };

        setMembersList([...membersList, newUser]);
        setCurrentUser(newUser);
        alert(lang === 'bn' ? 'রেজিস্ট্রেশন সফল হয়েছে!' : 'Registration successful!');
        setActiveTab('dashboard');
      }
    } catch (err) {
      // Local fallback sign in for testing
      if (authMode === 'login' && authEmail === 'admin@smartbusinessbd.com') {
        setCurrentUser({
          id: 'fd9122c4-20fe-4d28-af21-31f6564d51e0',
          name: 'Tanvir Hossain (Admin)',
          email: 'admin@smartbusinessbd.com',
          role: 'admin',
          balance: 85000,
          total_invested: 45000,
          phone: '01700000000',
          status: 'Active'
        });
        setActiveTab('dashboard');
      } else {
        setAuthError(err.message || 'Authentication error.');
      }
    } finally {
      setAuthLoading(false);
    }
  };

  const handleLogout = async () => {
    await supabase.auth.signOut();
    setSession(null);
    setActiveTab('home');
  };

  // Member Action Operations
  const handleDepositSubmit = async (e) => {
    e.preventDefault();
    const amt = parseFloat(depositForm.amount);
    if (!amt || amt <= 0 || !depositForm.trx_id || !depositForm.sender_number) {
      alert(lang === 'bn' ? 'সঠিক পরিমাণ, মোবাইল নম্বর এবং TrxID প্রদান করুন।' : 'Please fill all required fields properly.');
      return;
    }

    const newDep = {
      id: `dep-${Date.now()}`,
      user_id: currentUser.id,
      user_name: currentUser.name,
      method: depositForm.method,
      amount: amt,
      sender_number: depositForm.sender_number,
      trx_id: depositForm.trx_id,
      status: 'Pending',
      created_at: new Date().toISOString().replace('T', ' ').substring(0, 16)
    };

    try {
      await supabase.from('deposits').insert([newDep]);
    } catch (err) {
      console.log('Inserting into local store', err);
    }

    setDeposits([newDep, ...deposits]);
    setDepositForm({ method: 'bKash', amount: '', sender_number: '', trx_id: '' });
    alert(lang === 'bn' ? 'ডিপোজিট আবেদন জমা হয়েছে! ম্যানুয়াল ভেরিফিকেশনের পর ব্যালেন্সে যুক্ত হবে।' : 'Deposit request submitted for verification!');
    setActiveTab('deposits');
  };

  const handleWithdrawSubmit = async (e) => {
    e.preventDefault();
    const amt = parseFloat(withdrawForm.amount);
    if (!amt || amt <= 0 || !withdrawForm.account_number) {
      alert(lang === 'bn' ? 'সঠিক উইথড্রয়াল পরিমাণ ও একাউন্ট নম্বর দিন।' : 'Please enter valid withdrawal details.');
      return;
    }

    if (amt > currentUser.balance) {
      alert(lang === 'bn' ? 'আপনার একাউন্টে পর্যাপ্ত ব্যালেন্স নেই।' : 'Insufficient balance.');
      return;
    }

    const newWth = {
      id: `wth-${Date.now()}`,
      user_id: currentUser.id,
      user_name: currentUser.name,
      method: withdrawForm.method,
      amount: amt,
      account_number: withdrawForm.account_number,
      status: 'Pending',
      created_at: new Date().toISOString().replace('T', ' ').substring(0, 16)
    };

    try {
      await supabase.from('withdrawals').insert([newWth]);
    } catch (err) {
      console.log('Local store update', err);
    }

    setWithdrawals([newWth, ...withdrawals]);
    setCurrentUser(prev => ({ ...prev, balance: prev.balance - amt }));
    setWithdrawForm({ method: 'bKash', amount: '', account_number: '' });
    alert(lang === 'bn' ? 'উইথড্রয়াল আবেদন জমা করা হয়েছে।' : 'Withdrawal request submitted.');
    setActiveTab('withdrawals');
  };

  const handlePackageInvest = (pkg) => {
    if (currentUser.balance < pkg.amount) {
      alert(lang === 'bn' ? 'এই প্যাকেজে অংশগ্রহণের জন্য পর্যাপ্ত ব্যালেন্স নেই। অনুগ্রহ করে প্রথমে ডিপোজিট করুন।' : 'Insufficient balance for this package.');
      return;
    }

    const newPart = {
      id: `prt-${Date.now()}`,
      user_id: currentUser.id,
      package_name: pkg.name,
      sector: pkg.sector,
      amount: pkg.amount,
      status: 'Active',
      joined_at: new Date().toISOString().split('T')[0]
    };

    setParticipations([newPart, ...participations]);
    setCurrentUser(prev => ({
      ...prev,
      balance: prev.balance - pkg.amount,
      total_invested: prev.total_invested + pkg.amount
    }));

    alert(lang === 'bn' ? `অভিনন্দন! আপনি "${pkg.name}" প্যাকেজে সফলভাবে অংশগ্রহণ করেছেন।` : `Successfully joined ${pkg.name}`);
  };

  // Admin Operations
  const handleApproveDeposit = async (dep) => {
    try {
      await supabase.rpc('approve_deposit', { deposit_id: dep.id });
    } catch (err) {
      console.log('Local approve executed', err);
    }

    setDeposits(deposits.map(d => d.id === dep.id ? { ...d, status: 'Approved' } : d));
    setMembersList(membersList.map(m => m.id === dep.user_id ? { ...m, balance: m.balance + dep.amount } : m));
    
    if (dep.user_id === currentUser.id) {
      setCurrentUser(prev => ({ ...prev, balance: prev.balance + dep.amount }));
    }

    setAdminLogs([{
      id: `log-${Date.now()}`,
      admin_name: currentUser.name,
      action: 'Approve Deposit',
      details: `Approved ৳${dep.amount} for ${dep.user_name} (TrxID: ${dep.trx_id})`,
      timestamp: new Date().toISOString().replace('T', ' ').substring(0, 16)
    }, ...adminLogs]);
  };

  const handleRejectDeposit = (depId) => {
    setDeposits(deposits.map(d => d.id === depId ? { ...d, status: 'Rejected' } : d));
  };

  const handleApproveWithdrawal = (wth) => {
    setWithdrawals(withdrawals.map(w => w.id === wth.id ? { ...w, status: 'Approved' } : w));
    setAdminLogs([{
      id: `log-${Date.now()}`,
      admin_name: currentUser.name,
      action: 'Approve Withdrawal',
      details: `Approved payout of ৳${wth.amount} for ${wth.user_name}`,
      timestamp: new Date().toISOString().replace('T', ' ').substring(0, 16)
    }, ...adminLogs]);
  };

  const handleRejectWithdrawal = (wth) => {
    setWithdrawals(withdrawals.map(w => w.id === wth.id ? { ...w, status: 'Rejected' } : w));
    setMembersList(membersList.map(m => m.id === wth.user_id ? { ...m, balance: m.balance + wth.amount } : m));
    if (wth.user_id === currentUser.id) {
      setCurrentUser(prev => ({ ...prev, balance: prev.balance + wth.amount }));
    }
  };

  const handleToggleMemberStatus = (memberId) => {
    setMembersList(membersList.map(m => {
      if (m.id === memberId) {
        const nextStatus = m.status === 'Active' ? 'Suspended' : 'Active';
        return { ...m, status: nextStatus };
      }
      return m;
    }));
  };

  const handleCreatePackage = (e) => {
    e.preventDefault();
    if (!newPkgForm.name || !newPkgForm.amount) return;

    const newPkg = {
      ...newPkgForm,
      id: `pkg-${Date.now()}`,
      amount: parseFloat(newPkgForm.amount)
    };

    setPackages([newPkg, ...packages]);
    setNewPkgForm({ sector: 'E-commerce', name: '', amount: 5000, duration_days: 60, expected_profit_rate: '4.0% - 6.0%', status: 'Active', description: '' });
    alert(lang === 'bn' ? 'নতুন ব্যবসা প্যাকেজ যুক্ত হয়েছে।' : 'New package created.');
  };

  // ZIP Source File Builder Engine
  const handleDownloadProjectZIP = async () => {
    setIsZipping(true);
    setZipProgress(10);

    try {
      const zip = new JSZip();

      // 1. Root package.json
      zip.file("package.json", JSON.stringify({
        name: "smart-business-bd-project",
        private: true,
        version: "1.0.0",
        type: "module",
        scripts: {
          dev: "vite",
          build: "vite build",
          preview: "vite preview"
        },
        dependencies: {
          react: "^18.3.1",
          "react-dom": "^18.3.1",
          "@supabase/supabase-js": "^2.45.0",
          "lucide-react": "^0.344.0",
          jszip: "^3.10.1"
        },
        devDependencies: {
          "@types/react": "^18.3.0",
          "@vitejs/plugin-react": "^4.3.0",
          autoprefixer: "^10.4.19",
          postcss: "^8.4.38",
          tailwindcss: "^3.4.3",
          vite: "^5.2.0"
        }
      }, null, 2));

      setZipProgress(25);

      // 2. Vite Config
      zip.file("vite.config.js", `
import { defineConfig } from 'vite';
import react from '@vitejs/plugin-react';

export default defineConfig({
  plugins: [react()],
  server: { port: 3000 }
});
      `.trim());

      // 3. index.html
      zip.file("index.html", `
<!DOCTYPE html>
<html lang="bn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#020617" />
    <title>Smart Business BD - Full Stack Business Platform</title>
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased font-sans">
    <div id="root"></div>
    <script type="module" src="/src/main.jsx"></script>
  </body>
</html>
      `.trim());

      // 4. PWA Manifest & Service Worker
      zip.file("public/manifest.json", JSON.stringify({
        short_name: "SmartBizBD",
        name: "Smart Business BD Platform",
        icons: [
          { src: "icon-192.png", type: "image/png", sizes: "192x192" },
          { src: "icon-512.png", type: "image/png", sizes: "512x512" }
        ],
        start_url: "/",
        background_color: "#020617",
        theme_color: "#0f172a",
        display: "standalone"
      }, null, 2));

      zip.file("public/sw.js", `
const CACHE_NAME = 'smartbiz-v1';
self.addEventListener('install', (e) => {
  e.waitUntil(
    caches.open(CACHE_NAME).then((cache) => cache.addAll(['/', '/index.html']))
  );
});
self.addEventListener('fetch', (e) => {
  e.respondWith(
    caches.match(e.request).then((res) => res || fetch(e.request))
  );
});
      `.trim());

      setZipProgress(50);

      // 5. Supabase Initialization Module
      zip.file("src/supabaseClient.js", `
import { createClient } from '@supabase/supabase-js';

const SUPABASE_URL = "${SUPABASE_URL}";
const SUPABASE_ANON_KEY = "${SUPABASE_ANON_KEY}";

export const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
      `.trim());

      // 6. Complete Database SQL Schema & RPC Functions
      zip.file("supabase/migrations/20260101_init_schema.sql", `
-- =========================================================================
-- Smart Business BD Database Schema Migration
-- Supabase Project: https://ielwpoqwsqqbleluicvt.supabase.co
-- Admin User: fd9122c4-20fe-4d28-af21-31f6564d51e0
-- =========================================================================

-- Profiles Table
CREATE TABLE IF NOT EXISTS public.profiles (
  id UUID REFERENCES auth.users ON DELETE CASCADE PRIMARY KEY,
  name TEXT NOT NULL,
  email TEXT UNIQUE NOT NULL,
  phone TEXT,
  role TEXT DEFAULT 'member' CHECK (role IN ('member', 'admin')),
  balance NUMERIC(12, 2) DEFAULT 0.00,
  status TEXT DEFAULT 'Active' CHECK (status IN ('Active', 'Suspended')),
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Business Packages Table
CREATE TABLE IF NOT EXISTS public.business_packages (
  id TEXT PRIMARY KEY,
  sector TEXT NOT NULL,
  name TEXT NOT NULL,
  amount NUMERIC(12,2) NOT NULL,
  duration_days INT NOT NULL,
  expected_profit_rate TEXT NOT NULL,
  description TEXT,
  status TEXT DEFAULT 'Active',
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Payment Methods Table
CREATE TABLE IF NOT EXISTS public.payment_methods (
  id TEXT PRIMARY KEY,
  name TEXT NOT NULL,
  type TEXT NOT NULL,
  number TEXT NOT NULL,
  instructions TEXT,
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Deposits Table
CREATE TABLE IF NOT EXISTS public.deposits (
  id TEXT PRIMARY KEY,
  user_id UUID REFERENCES public.profiles(id),
  user_name TEXT,
  method TEXT NOT NULL,
  amount NUMERIC(12,2) NOT NULL,
  sender_number TEXT NOT NULL,
  trx_id TEXT UNIQUE NOT NULL,
  status TEXT DEFAULT 'Pending' CHECK (status IN ('Pending', 'Approved', 'Rejected')),
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Withdrawals Table
CREATE TABLE IF NOT EXISTS public.withdrawals (
  id TEXT PRIMARY KEY,
  user_id UUID REFERENCES public.profiles(id),
  user_name TEXT,
  method TEXT NOT NULL,
  amount NUMERIC(12,2) NOT NULL,
  account_number TEXT NOT NULL,
  status TEXT DEFAULT 'Pending' CHECK (status IN ('Pending', 'Approved', 'Rejected')),
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Participations Table
CREATE TABLE IF NOT EXISTS public.participations (
  id TEXT PRIMARY KEY,
  user_id UUID REFERENCES public.profiles(id),
  package_name TEXT NOT NULL,
  sector TEXT NOT NULL,
  amount NUMERIC(12,2) NOT NULL,
  status TEXT DEFAULT 'Active',
  joined_at TIMESTAMPTZ DEFAULT NOW()
);

-- Support Tickets Table
CREATE TABLE IF NOT EXISTS public.support_tickets (
  id TEXT PRIMARY KEY,
  user_id UUID REFERENCES public.profiles(id),
  user_name TEXT,
  subject TEXT NOT NULL,
  category TEXT DEFAULT 'General',
  message TEXT NOT NULL,
  status TEXT DEFAULT 'Open',
  created_at TIMESTAMPTZ DEFAULT NOW()
);

-- Admin Audit Logs
CREATE TABLE IF NOT EXISTS public.admin_audit_logs (
  id TEXT PRIMARY KEY,
  admin_name TEXT NOT NULL,
  action TEXT NOT NULL,
  details TEXT,
  timestamp TIMESTAMPTZ DEFAULT NOW()
);

-- Security RLS
ALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.deposits ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.withdrawals ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.business_packages ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Allow public read for packages" ON public.business_packages FOR SELECT USING (true);
CREATE POLICY "Allow members self profile access" ON public.profiles FOR SELECT USING (auth.uid() = id);

-- Database Stored Procedure Functions
CREATE OR REPLACE FUNCTION approve_deposit(deposit_id TEXT)
RETURNS VOID AS $$
DECLARE
  dep_rec RECORD;
BEGIN
  SELECT * INTO dep_rec FROM public.deposits WHERE id = deposit_id AND status = 'Pending';
  IF FOUND THEN
    UPDATE public.deposits SET status = 'Approved' WHERE id = deposit_id;
    UPDATE public.profiles SET balance = balance + dep_rec.amount WHERE id = dep_rec.user_id;
  END IF;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;
      `.trim());

      setZipProgress(75);

      // 7. Bengali README Instruction
      zip.file("README_BN.md", `
# Smart Business BD - সোর্স কোড নির্দেশিকা

এটি **Smart Business BD** প্ল্যাটফর্মের ১০০% প্রডাকশন-রেডি Full-Stack সোর্স কোড।

## কম্পিউটার বা সার্ভারে সেটআপ করার নিয়ম:

১. ডাউনলোডকৃত \`Smart-Business-BD-Project.zip\` ফাইলটি Extract/Unzip করুন।
২. ফোল্ডারের ভেতরে টার্মিনাল খুলে ডিপেন্ডেন্সি ইনস্টল করুন:
   \`\`\`bash
   npm install
   \`\`\`
৩. লোকাল ডেভেলপমেন্ট চালু করতে:
   \`\`\`bash
   npm run dev
   \`\`\`
৪. প্রডাকশন ওয়েব বা অ্যান্ড্রয়েড PWA বিল্ড তৈরি করতে:
   \`\`\`bash
   npm run build
   \`\`\`

## Supabase ডেটাবেস কনফিগারেশন:
- প্রজেক্টের সাথে \`supabase/migrations/20260101_init_schema.sql\` ফাইলটি যুক্ত আছে।
- এটি আপনার Supabase SQL Editor এ পেস্ট করে সকল টেবিল ও RLS Functions কার্যকর করতে পারবেন।
      `.trim());

      // 8. Main JavaScript Entry Point & Styling
      zip.file("src/main.jsx", `
import React from 'react';
import ReactDOM from 'react-dom/client';
import App from './App.jsx';
import './index.css';

ReactDOM.createRoot(document.getElementById('root')).render(
  <React.StrictMode>
    <App />
  </React.StrictMode>
);
      `.trim());

      zip.file("src/index.css", `
@tailwind base;
@tailwind components;
@tailwind utilities;

body {
  margin: 0;
  font-family: system-ui, -apple-system, sans-serif;
}
      `.trim());

      // Add actual react component code
      const currentCode = document.querySelector('script[type="module"]')?.innerText || "// Smart Business BD Source";
      zip.file("src/App.jsx", currentCode);

      setZipProgress(95);

      // 9. Generate and Trigger Download
      const blobContent = await zip.generateAsync({ type: "blob" });
      const downloadLink = document.createElement("a");
      downloadLink.href = URL.createObjectURL(blobContent);
      downloadLink.download = "Smart-Business-BD-Project.zip";
      document.body.appendChild(downloadLink);
      downloadLink.click();
      document.body.removeChild(downloadLink);

      setZipProgress(100);
      setTimeout(() => {
        setIsZipping(false);
        setZipProgress(0);
      }, 1200);

    } catch (err) {
      console.error("ZIP Generation Failed", err);
      alert("ZIP ফাইল জেনারেট করতে সমস্যা হয়েছে। আবার চেষ্টা করুন।");
      setIsZipping(false);
    }
  };

  // Metrics Calculations
  const totalApprovedDeposits = useMemo(() => 
    deposits.filter(d => d.status === 'Approved').reduce((acc, curr) => acc + curr.amount, 0), [deposits]);
  const pendingDepositsCount = useMemo(() => 
    deposits.filter(d => d.status === 'Pending').length, [deposits]);
  const totalApprovedWithdrawals = useMemo(() => 
    withdrawals.filter(w => w.status === 'Approved').reduce((acc, curr) => acc + curr.amount, 0), [withdrawals]);
  const pendingWithdrawalsCount = useMemo(() => 
    withdrawals.filter(w => w.status === 'Pending').length, [withdrawals]);

  return (
    <div className={`min-h-screen ${theme === 'dark' ? 'bg-slate-950 text-slate-100' : 'bg-slate-50 text-slate-900'} transition-colors duration-200 flex flex-col`}>
      
      {/* Top Header Navigation Bar */}
      <header className="sticky top-0 z-50 bg-slate-900/90 backdrop-blur-md border-b border-slate-800 text-white px-4 py-3 shadow-lg flex items-center justify-between">
        <div className="flex items-center space-x-3 cursor-pointer" onClick={() => setActiveTab('home')}>
          <div className="bg-gradient-to-tr from-emerald-500 to-teal-400 p-2 rounded-xl text-slate-950 shadow-lg">
            <Building2 className="h-6 w-6 stroke-[2.5]" />
          </div>
          <div>
            <h1 className="text-xl font-bold tracking-tight bg-gradient-to-r from-emerald-400 to-teal-200 bg-clip-text text-transparent">
              {t.appName}
            </h1>
            <p className="text-[11px] text-slate-400 hidden sm:block">{t.tagline}</p>
          </div>
        </div>

        {/* Action Controls & Dynamic ZIP Download */}
        <div className="flex items-center space-x-2 sm:space-x-3">
          
          {/* Prominent Zip Exporter Button */}
          <button
            onClick={handleDownloadProjectZIP}
            disabled={isZipping}
            className="flex items-center space-x-1 sm:space-x-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-xs sm:text-sm font-semibold px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl shadow-lg border border-emerald-400/30 transition-all transform active:scale-95"
          >
            {isZipping ? (
              <>
                <RefreshCw className="h-4 w-4 animate-spin text-emerald-200" />
                <span>{zipProgress}%</span>
              </>
            ) : (
              <>
                <Download className="h-4 w-4" />
                <span className="hidden sm:inline">Download Source ZIP</span>
                <span className="sm:hidden">ZIP</span>
              </>
            )}
          </button>

          {/* Language Switcher */}
          <button
            onClick={() => setLang(lang === 'bn' ? 'en' : 'bn')}
            className="flex items-center space-x-1 bg-slate-800 hover:bg-slate-700 px-2.5 py-1.5 rounded-lg text-xs font-semibold border border-slate-700 text-slate-300 transition"
          >
            <Languages className="h-4 w-4 text-emerald-400" />
            <span>{lang.toUpperCase()}</span>
          </button>

          {/* Dark / Light Toggle */}
          <button
            onClick={() => setTheme(theme === 'dark' ? 'light' : 'dark')}
            className="p-1.5 bg-slate-800 hover:bg-slate-700 rounded-lg border border-slate-700 text-amber-400 transition"
          >
            {theme === 'dark' ? <Sun className="h-4 w-4" /> : <Moon className="h-4 w-4 text-slate-300" />}
          </button>

          {/* Role Status or Login Trigger */}
          {currentUser ? (
            <div className="hidden sm:flex items-center space-x-2 pl-2 border-l border-slate-800">
              <span className={`text-xs px-2.5 py-1 rounded-full font-bold ${
