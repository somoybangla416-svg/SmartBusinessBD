            >
              {t.login}
            </button>
          )}
        </div>
      </header>

      {/* Main Container Layout */}
      <div className="flex-1 flex flex-col md:flex-row max-w-7xl w-full mx-auto p-3 sm:p-6 gap-6">
        
        {/* Responsive Navigation Sidebar */}
        <aside className="w-full md:w-64 shrink-0 flex flex-row md:flex-col justify-between bg-slate-900 border border-slate-800 rounded-2xl p-3 sm:p-4 gap-2 shadow-xl overflow-x-auto">
